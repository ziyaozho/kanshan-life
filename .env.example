# DeepSeek API Key
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-api-key-here

# 知乎 OAuth 2.0
# 在 https://open.zhihu.com/ 注册应用后获取
ZHIHU_APP_ID=your-zhihu-app-id
ZHIHU_APP_KEY=your-zhihu-app-key
# 开发环境用 http://localhost:3000/api/auth/zhihu/callback
# 生产环境用 https://你的域名/api/auth/zhihu/callback
ZHIHU_REDIRECT_URI=http://localhost:3000/api/auth/zhihu/callback
